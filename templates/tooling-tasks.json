[
  {
    "label": "Acore: CLI editor compatibility",
    "command": "\"$ACORE_CLI\"",
    "args": [
      "editor",
      "info",
      "--json"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "env": {
      "ACORE_CLI": "axiom"
    },
    "shell": {
      "program": "/bin/sh"
    }
  },
  {
    "label": "Acore: CLI editor help",
    "command": "\"$ACORE_CLI\"",
    "args": [
      "editor",
      "--help"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "env": {
      "ACORE_CLI": "axiom"
    },
    "shell": {
      "program": "/bin/sh"
    }
  },
  {
    "label": "Acore: CLI foreign preparation help",
    "command": "\"$ACORE_CLI\"",
    "args": [
      "extensions",
      "prepare-ide",
      "\"$ACORE_ALIAS\""
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "env": {
      "ACORE_CLI": "axiom",
      "ACORE_ALIAS": "--help"
    },
    "shell": {
      "program": "/bin/sh"
    }
  }
]
