[
  {
    "label": "Acore: check saved config",
    "command": "\"$ACORE_CLI\"",
    "args": [
      "editor",
      "check",
      "--root",
      "\"$ACORE_PROJECT_ROOT\"",
      "--entry",
      "\"$ACORE_ENTRY\"",
      "--kind",
      "config",
      "--json"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "none",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "env": {
      "ACORE_CLI": "axiom",
      "ACORE_PROJECT_ROOT": "$ZED_WORKTREE_ROOT",
      "ACORE_ENTRY": "$ZED_WORKTREE_ROOT/main.acore"
    },
    "shell": {
      "program": "/bin/sh"
    }
  },
