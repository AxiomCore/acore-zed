{
  "Acore typed configuration": {
    "prefix": "acore-config",
    "description": "Typed configuration with a reusable class and scoped function.",
    "body": [
      "class Settings {",
      "  enabled: Boolean = true",
      "  label: String = \"${1:Editor}\"",
      "}",
      "",
      "settings: Settings = Settings { enabled = false }",
      "transform = (value: Int) -> value + ${2:1}",
      "$0"
    ]
  },
  "Acore backend contract": {
    "prefix": "acore-backend",
    "description": "Offline typed backend contract starter.",
    "body": [
      "profile backend 1",
      "project(id: \"${1:editor.backend}\", version: \"${2:1.0.0}\")",
      "",
      "model Task { id: String title: String }",
      "",
      "endpoint listTasks(method: GET, path: \"/tasks\") {",
      "  response(type: List<Models.Task>)",
      "}",
      "$0"
    ]
  },
  "Acore frontend application": {
    "prefix": "acore-frontend",
    "description": "Typed frontend app, state and action starter.",
    "body": [
      "module ${1:editor}.ui",
      "",
      "app EditorApp { route \"/\" => Home }",
      "",
      "page Home {",
      "  state count: Int = 0",
      "  action increment() { count = count + 1 }",
      "  view {",
      "    View {",
      "      Text(\"${2:Hello}\")",
      "      Button(label: \"Increment\", on_press: increment)",
      "    }",
      "  }",
      "}",
      "$0"
    ]
  },
  "Acore PostgreSQL contract": {
    "prefix": "acore-database",
    "description": "Offline PostgreSQL schema. This declares a contract without migration authority.",
    "body": [
      "module ${1:editor}.storage",
      "",
      "database editor(engine: DatabaseEngine.postgres) {",
      "  manage(schemas: [Schemas.app], mode: ManagementMode.ownedObjects)",
      "  schema app {",
      "    table tasks {",
      "      id: Pg.Uuid",
      "      title: Pg.Text",
      "      primaryKey(columns: [.id])",
      "    }",
      "  }",
      "}",
      "$0"
    ]
  },
  "Acore SQLite contract": {
    "prefix": "acore-sqlite",
    "description": "SQLite strict table and checked dialect. Select a database project and schema entry.",
    "body": [
      "profile database 1",
      "module editor.sqlite",
      "database storage(engine: DatabaseEngine.sqlite) {",
      " manage(schemas: [Schemas.main],mode: ManagementMode.ownedObjects)",
      " schema main {",
      "  table tasks(strict: true) {",
      "   id: Sqlite.Integer",
      "   title: Sqlite.Text",
      "   primaryKey(columns: [.id])",
      "  }",
      " }",
      "}",
      "$0"
    ]
  },
  "Acore advanced PostgreSQL contract": {
    "prefix": "acore-postgres-advanced",
    "description": "PostgreSQL domain, SQL function and dependency-declared view; offline authoring only.",
    "body": [
      "profile database 1",
      "module storage",
      "database storage(engine: DatabaseEngine.postgres) {",
      " manage(schemas: [Schemas.app], mode: ManagementMode.ownedObjects)",
      " schema app {",
      "",
      "domain positive(storageType: Pg.Int32, nullable: true)",
      "table items { id: Types.app.positive(nullable: true) }",
      "function plus(arguments: [{name: \"x\", storageType: Pg.Int32, mode: \"in\"}], returns: {kind: \"scalar\", storageType: Pg.Int32, set: false}, language: \"sql\", body: Sql.body(source: \"SELECT x + 1\", dependencies: [], effects: SqlEffects.unknown), volatility: \"immutable\", strict: true, securityDefiner: false, parallel: \"safe\", settings: {})",
      "view labels(query: Sql.query(source: \"SELECT id FROM app.items\", dependencies: [Tables.app.items], effects: SqlEffects.unknown), columns: [{name: \"id\", storageType: Types.app.positive, nullable: true}], securityInvoker: true, securityBarrier: false, checkOption: \"none\")",
      "",
      " }",
      "}",
      "$0"
    ]
  },
  "Acore evolution intent": {
    "prefix": "acore-evolution",
    "description": "Dedicated evolution document. Select database.evolution.previous=Empty and current=<schema> before checking.",
    "body": [
      "profile database 1",
      "evolution initial(from: Empty,to: Current,coordination: EvolutionCoordination.maintenanceFenced) {",
      "}",
      "$0"
    ]
  },
  "Acore security contract": {
    "prefix": "acore-security",
    "description": "Security and SensitiveData example. The backend manifest must declare public-web and workspaceMember audiences.",
    "body": [
      "// Safe security baseline. This is a self-contained contract fixture; a real",
      "// project normally receives Models/endpoints from the Go or Python extractor.",
      "module axiom.examples.security_mode_v1",
      "",
      "project(id: \"security-mode-v1\", version: \"v0.1.0\")",
      "",
      "variant default(include: [\"*\"])",
      "",
      "model Customer {",
      "  id: String",
      "  email: String",
      "  displayName: String",
      "} also entity",
      "",
      "model Order {",
      "  id: String",
      "  customerId: String",
      "  status: String",
      "} also entity",
      "",
      "",
      "",
      "relationship orderCustomer(from: Entities.order, to: Entities.customer, via: \"customerId\", required: true)",
      "",
      "projection publicCustomer(entity: Entities.customer, fields: [.id, .displayName], audience: Audience[\"public-web\"])",
      "",
      "projection memberOrder(entity: Entities.order, fields: [.id, .customerId, .status], audience: Audience.workspaceMember)",
      "",
      "endpoint Health(method: GET, path: \"/health\") {",
      "  response(type: Void)",
      "}",
      "",
      "endpoint GetCustomer(method: GET, path: \"/customers/{id}\") {",
      "  request {",
      "    path(\"id\", type: String)",
      "  }",
      "  response(type: Entities.customer, projection: Projections.publicCustomer)",
      "}",
      "",
      "endpoint UpdateOrder(method: PATCH, path: \"/orders/{id}\") {",
      "  request {",
      "    path(\"id\", type: String)",
      "  }",
      "  response(type: Entities.order, projection: Projections.memberOrder)",
      "}",
      "",
      "security(",
      "  mode: \"audit\",",
      "  principals: {workspaceMember: SecurityPrincipal(roles: [\"member\"])},",
      "  auth: {",
      "    browserSession: AuthenticationPolicy(transport: \"cookie\", secure: true, httpOnly: true, sameSite: \"lax\", sessionRotation: true)",
      "  },",
      "  permissions: {",
      "    readCustomer: Permission(),",
      "    editOrder: Permission(requiresRateLimit: true, requiresIdempotency: true, requiresCsrf: true)",
      "  },",
      "  resources: {order: ProtectedResource(entity: Entities.order)},",
      "  policies: {",
      "    memberRead: SecurityPolicy(principals: [\"workspaceMember\"], auth: \"browserSession\"),",
      "    orderEditor: SecurityPolicy(",
      "      principals: [\"workspaceMember\"],",
      "      auth: \"browserSession\",",
      "      resource: \"order\",",
      "      permissions: [\"editOrder\"],",
      "      relationship: \"orderCustomer\",",
      "      resourceBinding: \"principal.customerId == resource.customerId\"",
      "    )",
      "  },",
      "  defaultPolicy: \"memberRead\",",
      "  endpoints: {",
      "    Health: EndpointGuard(public: true),",
      "    UpdateOrder: EndpointGuard(",
      "      policy: \"orderEditor\",",
      "      resource: \"order\",",
      "      permission: \"editOrder\",",
      "      rateLimit: \"memberWrite\",",
      "      writableFields: [\"status\"],",
      "      idempotent: true",
      "    )",
      "  },",
      "  rateLimits: {memberWrite: RateLimit(maxRequests: 60, windowSeconds: 60, key: \"principal\")},",
      "  classifications: {",
      "    customerEmail: SensitiveData(target: \"Customer.email\", classification: \"PII\", audiences: [\"workspaceMember\"], redact: true)",
      "  },",
      "  csrf: CsrfPolicy(strategy: \"double_submit\", sameSite: \"lax\", secure: true, httpOnly: true),",
      "  cors: CorsPolicy(origins: [\"https://app.example.test\"], credentials: true, methods: [\"GET\", \"PATCH\"]),",
      "  cache: CacheSecurityPolicy(sharedAuthenticatedResponses: false, requireVaryByPrincipal: true),",
      "  observability: ObservabilitySecurityPolicy(redactClasses: [\"PII\", \"Secret\"], allowPayloads: false),",
      "  invariants: {",
      "    allRoutesAuthorized: SecurityRequirement(kind: \"require_authorization\", target: \"customer and order routes\"),",
      "    memberWritesSafe: SecurityRequirement(kind: \"require_idempotency\", target: \"editOrder\"),",
      "    noSensitiveLogs: SecurityRequirement(kind: \"no_secret_exposure\", target: \"logs and traces\")",
      "  }",
      ")",
      "$0"
    ]
  },
  "Acore managed backend composition": {
    "prefix": "acore-managed",
    "description": "Typed resource operation and named perform/invoke steps. Use type=backend in AxiomDeps.toml.",
    "body": [
      "project(id: \"workflow-server\", version: \"1.0.0\")",
      "variant default(include: [\"*\"])",
      "",
      "model Selector { id: Int32(min: 1) }",
      "model Task { title: String completed: Bool }",
      "model Problem { message: String }",
      "failure missing(payload: Models.Problem, status: 404)",
      "",
      "resource tasks(lifetime: ProviderLifetime.invocation) {",
      "  operation lookup(input: Int32, output: Models.Task, effect: EffectKind.read)",
      "}",
      "",
      "permission reader(claim: \"task.read\")",
      "guard reader(permission: Permissions.reader)",
      "",
      "action fetchTask(kind: ActionKind.query, input: Models.Selector, output: Models.Task) {",
      "  managed {",
      "    perform task(resource: Resources.tasks, operation: .lookup, input: Input.id)",
      "    result(value: Steps.task)",
      "  }",
      "  require(guard: Guards.reader)",
      "  errors(Failures.missing)",
      "}",
      "",
      "action readTask(kind: ActionKind.query, input: Models.Selector, output: Models.Task) {",
      "  managed {",
      "    invoke fetched(action: Actions.fetchTask, input: {id: Input.id})",
      "    result(value: Steps.fetched)",
      "  }",
      "  errors(Failures.missing)",
      "}",
      "",
      "action health(kind: ActionKind.query, output: String) {",
      "  managed { result(value: \"ready\") }",
      "}",
      "",
      "endpoint getTask(method: GET, path: \"/tasks/{id}\") {",
      "  request { path(\"id\", type: Int32) }",
      "  handle(action: Actions.readTask, input: {id: Input.path.id})",
      "  response(type: Models.Task)",
      "  errors(Failures.missing)",
      "}",
      "",
      "endpoint findTask(method: GET, path: \"/find\") {",
      "  request { query(\"key\", type: Int32) }",
      "  handle(action: Actions.readTask, input: {id: Input.query.key})",
      "  response(type: Models.Task)",
      "  errors(Failures.missing)",
      "}",
      "",
      "endpoint status(method: GET, path: \"/status\") {",
      "  handle(action: Actions.health)",
      "  response(type: String)",
      "}",
      "$0"
    ]
  },
  "Acore component callbacks": {
    "prefix": "acore-component",
    "description": "Typed component props and event payload. Use a frontend project and acore-ui/v6.",
    "body": [
      "module editor.components.ui",
      "component Caption(a: String,b: Int) {",
      " event change(value: String)",
      " view {Text(a)}",
      "}",
      "app Components {route Home \"/\" => Home}",
      "page Home {",
      " state title: String = \"hello\"",
      " state count: Int = 1",
      " action changed(value: String) {title = value}",
      " view {Input(value: title,accessibility_label: \"Title\",on_input: changed) Caption(b: count,a: title,on_change: changed)}",
      "}",
      "$0"
    ]
  },
  "Acore store and migration": {
    "prefix": "acore-store",
    "description": "Typed app store, explicit persistence and versioned migration; no credentials in ordinary UI storage.",
    "body": [
      "module editor.stores.ui",
      "model PreferencesV1 {theme: String}",
      "store preferences(scope: \"app\",persist: \"preferences\",key: \"dashboard\",version: 2) {",
      " state theme: String = \"system\"",
      " state compact: Bool = false",
      " migration 1(old: PreferencesV1) = {theme: old.theme,compact: false}",
      "}",
      "app Stores {route Home \"/\" => Home}",
      "page Home {",
      " action dark() {update stores.preferences.theme = \"dark\"}",
      " action reset() {store preferences.reset()}",
      " view {View {Text(stores.preferences.theme) Button(label: \"Dark\",on_press: dark) Button(label: \"Reset\",on_press: reset)}}",
      "}",
      "$0"
    ]
  },
  "Acore named routes": {
    "prefix": "acore-routes",
    "description": "Named routes, typed path/query arguments and checked navigation commands.",
    "body": [
      "module editor.routes.ui",
      "app Routes {",
      " route Home \"/\" => Home",
      " route Edit \"/tasks/:id\" => Details {path id: Int; query tab: String = \"edit\"}",
      "}",
      "page Home {action edit() {go Edit(id: 1)} view {Button(label: \"Edit\",on_press: edit)}}",
      "page Details {view {Text(to_string(route.params.id))}}",
      "$0"
    ]
  },
  "Acore form and application suite": {
    "prefix": "acore-application-suite",
    "description": "Stores, forms, arrays, routes, session and operation policies. Requires the companion Workflow contract from examples/authoring/application.",
    "body": [
      "module frontend.f6.session.ui",
      "use contract Workflow from \"workflow\" audience \"mobile\"",
      "model Tag { id: String; label: String }",
      "model Address {city: String}",
      "model Draft { title: String; start: Int; end: Int; tags: List<Tag>; address: Address }",
      "component TagEditor(tag: Tag) {",
      " state label: String = tag.label",
      " event change(value: Tag)",
      " action changed() {emit change({id: tag.id,label: label})}",
      " view {View(class: \"tag\") {Text(tag.id) Input(value: label,accessibility_label: \"Tag \" + tag.id) Button(label: \"Update \" + tag.id,on_press: changed)}}",
      "}",
      "model PreferencesV1 { theme: String }",
      "store preferences(scope: \"app\",persist: \"preferences\",key: \"dashboard\",version: 2) {",
      " state theme: String = \"system\"",
      " state compact: Bool = false",
      " migration 1(old: PreferencesV1) = {theme: old.theme,compact: false}",
      "}",
      "store selection(scope: \"session\") {state task: Int = 0}",
      "store routeDraft(scope: \"route\") {state note: String = \"\"}",
      "app Dashboard {",
      " route Home \"/\" => Home",
      " route Edit \"/tasks/:id\" => Details {",
      "  path id: Int",
      "  query tab: String = \"edit\"",
      "  query filter: String?",
      "  layout Shell",
      "  guard session.status == \"authenticated\"",
      "  denied \"/login\"",
      " }",
      " route Fixed \"/tasks/new\" => New",
      " route Login \"/login\" => Login",
      " route Old \"/old\" => Home {redirect \"/\"}",
      " not_found Missing",
      " signed_out \"/login\"",
      "}",
      "page Shell {",
      " state visits: Int = 1",
      " view {SafeArea {Text(\"Task dashboard\") Text(to_string(visits)) Outlet()}}",
      "}",
      "page Home {",
      " action edit() {go Edit(id: 1)}",
      " action theme() {update stores.preferences.theme = \"dark\"}",
      " action resetPreferences() {store preferences.reset()}",
      " view {SafeArea {Text(stores.preferences.theme) Button(label: \"Edit task\",on_press: edit) Button(label: \"Dark\",on_press: theme)}}",
      "}",
      "page New {view {SafeArea {Text(\"New task\")}}}",
      "page Missing {view {SafeArea {Text(\"Page not found\")}}}",
      "page Login {",
      " mutation login = Workflow.sign_in()",
      " query discovery = Workflow.discover() when false",
      " mutation logout = Workflow.sign_out()",
      " session_actions(discover: discovery,sign_in: login,sign_out: logout)",
      " action signIn() {session sign_in()}",
      " action discover() {session discover()}",
      " action home() {go Home()}",
      " view {SafeArea {Text(session.status) Text(session_ux.error ?? \"\") Button(label: \"Sign in\",disabled: session_ux.pending,on_press: signIn) Button(label: \"Discover session\",on_press: discover) Button(label: \"Open home\",on_press: home)}}",
      "}",
      "page Details {",
      " derived canEdit = (session.principal?.permissions ?? []).filter(|permission| permission == \"tasks.edit\").length > 0",
      " state draft: Draft = {title: \"\",start: 1,end: 2,tags: [],address: {city: \"London\"}}",
      " store editor(scope: \"component\") {state expanded: Bool = true}",
      " query available = Workflow.check(title: draft.title) when false",
      " mutation save = Workflow.save(id: route.params.id,title: draft.title)",
      " form_model edit(values: draft,submit: save,leave: true,reset_on_success: false) {",
      "  field \"address.city\"(parse: raw.trim(),validate: value.length > 0,message: \"City is required\",timing: \"blur\")",
      "  field title(parse: raw.trim(),validate: value.length > 0,message: \"Title is required\",timing: \"blur\")",
      "  field start(parse: to_int(raw),validate: value >= 0,message: \"Invalid start\",timing: \"change\")",
      "  field end(parse: to_int(raw),validate: value >= 0,message: \"Invalid end\",timing: \"submit\")",
      "  rule dates(validate: draft.end >= draft.start,field: \"end\",message: \"End must follow start\")",
      "  async title(operation: available,valid: validation_result.available,message: \"Title is already used\",debounce_ms: 100)",
      "  array tags(key: \"id\",validate: item.label.length > 0,message: \"Tag label is required\")",
      "  server invalid_title(field: \"title\",message: server_error.message)",
      " }",
      " action submit() {form edit.submit()}",
      " action retry() {form edit.retry()}",
      " action reset() {form edit.reset()}",
      " state nextTag: Int = 0",
      " action tag() {form edit.append.tags(item: {id: to_string(nextTag),label: \"Agent\"});nextTag = nextTag + 1}",
      " action removeTag() {form edit.remove.tags(id: \"0\")}",
      " action reorderTag() {form edit.move.tags(id: \"1\",index: 0)}",
      " action tagChanged(item: Tag) {form edit.change.tags(id: item.id,value: item)}",
      " mutation logout = Workflow.sign_out()",
      " mutation refreshSession = Workflow.sign_in() options(session_refresh: true)",
      " session_actions(sign_out: logout,sign_in: refreshSession)",
      " action signOut() {session sign_out()}",
      " action refresh() {session sign_in()}",
      " action goHome() {go Home()}",
      " action goOther() {go Edit(id: 2,tab: \"edit\")}",
      " action back() {back()}",
      " view {ScrollView(class: \"session-scroll\") {",
      "  Text(to_string(route.params.id))",
      "  Input(value: edit.values.address.city,accessibility_label: \"City\")",
      "  Input(value: edit.values.title,accessibility_label: \"Task title\")",
      "  Input(value: edit.fields.start.raw,accessibility_label: \"Start\")",
      "  Input(value: edit.fields.end.raw,accessibility_label: \"End\")",
      "  Text(edit.fields.title.error ?? \"\")",
      "  Text(edit.status)",
      "  Text(edit.error ?? \"\")",
      "  Text(to_string(edit.values.tags.length))",
      "  List(items: edit.values.tags,accessibility_label: \"Tags\",class: \"tags\",enable_nested_scroll: true,key: |rowTag| rowTag.id,list_type: \"single\",span_count: 1,scroll_orientation: \"vertical\") {rowTag => TagEditor(tag: rowTag,on_change: tagChanged)}",
      "  Button(label: \"Save\",disabled: edit.pending,on_press: submit)",
      "  Button(label: \"Retry\",disabled: edit.pending,on_press: retry)",
      "  Button(label: \"Reset\",on_press: reset)",
      "  Button(label: \"Add tag\",on_press: tag)",
      "  Button(label: \"Remove first tag\",on_press: removeTag)",
      "  Button(label: \"Reverse two tags\",on_press: reorderTag)",
      "  Text(session.status)",
      "  Button(label: \"Refresh session\",on_press: refresh)",
      "  Button(label: \"Sign out\",on_press: signOut)",
      "  Button(label: \"Permission action\",disabled: !canEdit,on_press: goOther)",
      "  Button(label: \"Home\",on_press: goHome)",
      "  Button(label: \"Other task\",on_press: goOther)",
      "  Button(label: \"Back\",on_press: back)",
      " }",
      "}",
      "}",
      "",
      "styles {",
      " .session-scroll {width: 100%;height: 600px}",
      " .tags {height: 140px; width: 100%}",
      " .tag {width: 100%; display: flex; flex-direction: column}",
      " Input {height: 36px; width: 100%; margin-bottom: 4px}",
      " Button {height: 32px; margin-bottom: 4px}",
      " Text {font-size: 16px}",
      "}",
      "$0"
    ]
  }
}
